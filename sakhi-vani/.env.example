# ---------- SAKHI VANI backend (backend-api) ----------
# Copy to backend-api/.env (setup.bat does this) and fill in values. Never commit real secrets.
API_PORT=4000
NODE_ENV=development
# Required in production. Generate a long random string.
JWT_SECRET=
TOKEN_TTL_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true

# ---------- AI (optional) ----------
# Google Gemini — server-side only. Leave empty to use the rule-based extraction engine.
APP_GEMINI_API_KEY=
APP_GEMINI_MODEL=gemini-1.5-flash

# ---------- Speech (optional) ----------
# Sarvam AI STT/TTS — verify endpoint/model names against current Sarvam docs.
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=

# ---------- Telephony (optional) ----------
# Set TELEPHONY_PROVIDER=exotel and fill credentials once you have a provisioned number.
TELEPHONY_PROVIDER=none
TELEPHONY_WEBHOOK_SECRET=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=

# ---------- Firebase (optional, future adapter) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
